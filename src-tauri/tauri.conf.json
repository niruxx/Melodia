{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melodia",
  "version": "1.0.0",
  "identifier": "com.melodia.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prebundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Melodia",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "app", "dmg", "appimage", "deb", "rpm"],
    "windows": {
      "wix": {
        "upgradeCode": "5605eda2-faf0-53ae-81c1-07cff09537a4"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/main.py": "sidecar/main.py",
      "../sidecar/requirements.txt": "sidecar/requirements.txt"
    }
  }
}
